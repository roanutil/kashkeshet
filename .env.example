# Copy to .env (kept out of git) for compose.yaml or compose.tailscale.yaml.

# The kkt version to run, such as 0.3.0. To upgrade, change it and run
# `docker compose up -d`.
KKT_VERSION=

# For compose.tailscale.yaml only. Add the line
#   COMPOSE_FILE=compose.tailscale.yaml
# so that every `docker compose` command uses it, not compose.yaml.
# A Tailscale auth key from https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
# The machine name kkt gets on your tailnet.
TS_HOSTNAME=kkt
# Your tailnet's DNS name, shown under DNS in the Tailscale admin console,
# such as tail1234.ts.net. kkt answers to ${TS_HOSTNAME}.${TS_TAILNET}.
TS_TAILNET=
